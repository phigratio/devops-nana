# Copy to .env and adjust. Passwords do NOT live here -- they are files in
# ./secrets/, mounted as Docker secrets. Run ./scripts/generate-secrets.sh.

# Published app port on the host
APP_PORT=3000
# Bind address. Keep 127.0.0.1 if a reverse proxy fronts the app.
APP_BIND=0.0.0.0

# Image tag built by `docker compose build`
APP_VERSION=1.0.0

# Database
DB_NAME=user-account
MONGO_ROOT_USERNAME=root
MONGO_APP_USERNAME=app

# Dev overlay only: published MongoDB port
MONGO_PORT=27017

# mongo-express (tools profile) -- change before exposing it anywhere
MONGO_EXPRESS_PORT=8081
ME_USERNAME=admin
ME_PASSWORD=change-me
